{
  description = "usabarashi blog — static site generated by Hakyll";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      systems = [
        "aarch64-darwin"
        "x86_64-linux"
      ];

      forAllSystems =
        f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});
    in
    {
      packages = forAllSystems (pkgs: {
        default = pkgs.haskellPackages.callCabal2nix "blog" ./. { };
      });

      devShells = forAllSystems (pkgs: {
        default = pkgs.haskellPackages.shellFor {
          packages = ps: [ (ps.callCabal2nix "blog" ./. { }) ];
          nativeBuildInputs = with pkgs; [
            cabal-install
            pandoc
          ];
        };
      });

      apps = forAllSystems (pkgs: {
        default = {
          type = "app";
          program = "${self.packages.${pkgs.stdenv.hostPlatform.system}.default}/bin/site";
          meta.description = "Build and preview the blog";
        };
      });

      # Reproducible verification that the site actually renders with the
      # pinned toolchain, and that the output stays safe to publish.
      checks = forAllSystems (pkgs: {
        site = pkgs.stdenvNoCC.mkDerivation {
          name = "blog-site";
          src = self;
          nativeBuildInputs = [ self.packages.${pkgs.stdenv.hostPlatform.system}.default ];
          buildPhase = ''
            export HOME=$(mktemp -d)
            site build
            test -f _site/index.html
            test -f _site/rss.xml
            test -f _site/sitemap.xml
            test -f _site/tags.html
            # Drafts must never be rendered.
            test ! -e _site/drafts
            # HTML must only use relativized URLs, otherwise the same output
            # could not be served from /blog/.
            if grep -rIlE '(href|src)="/' _site --include='*.html'; then
              echo "root-absolute URL left in generated HTML" >&2
              exit 1
            fi
          '';
          installPhase = ''
            mkdir -p $out
            cp -r _site/. $out/
          '';
        };
      });
    };
}
